# Copy this file to .env and fill in real values before running
# `docker-compose up`. Never commit the real .env file.

# Must be at least 32 characters — used to sign JWT access tokens (HS256).
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# Optional. If left blank, AI contract analysis returns mock data.
OPENAI_API_KEY=

# Optional. If left blank, outgoing emails are logged to the console
# instead of actually being sent.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@freelanceflow.local
